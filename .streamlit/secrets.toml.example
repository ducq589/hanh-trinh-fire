# Sao chép thành .streamlit/secrets.toml (chạy thử chế độ cloud trên máy)
# hoặc dán vào Streamlit Cloud ▸ App settings ▸ Secrets.  KHÔNG đưa file thật lên GitHub.
[supabase]
url = "https://<project-ref>.supabase.co"            # Supabase ▸ Project Settings ▸ API ▸ Project URL
anon_key = "<anon public key>"                        # Supabase ▸ Project Settings ▸ API Keys ▸ anon / publishable
db_url = "postgresql://postgres.<project-ref>:<MẬT-KHẨU-DB>@aws-0-<region>.pooler.supabase.com:5432/postgres"
                                                      # Supabase ▸ Connect ▸ Session pooler
allow_signup = false                                  # true = ai có email cũng tự đăng ký được
google = false                                        # true = hiện nút "Đăng nhập bằng Google" (cần bật Google ở Supabase)
site_url = "https://fire-travel.streamlit.app"        # địa chỉ app để Google đưa người dùng quay về (trên máy: http://localhost:8501)
contact_email = ""                                    # email liên hệ hiện ở trang Chính sách quyền riêng tư / Điều khoản

# Ủng hộ tác giả bằng VietQR (tuỳ chọn – bỏ trống/xoá mục này thì nút ủng hộ không hiện)
[donate]
bank_bin = ""                                         # mã BIN ngân hàng, VD Vietcombank 970436 (xem Trien_khai_cloud.md)
account_no = ""                                       # số tài khoản nhận
account_name = ""                                     # tên chủ tài khoản, IN HOA KHÔNG DẤU
bank_name = ""                                        # tên hiển thị, VD Vietcombank
message = "Ung ho Hanh trinh FIRE"                    # nội dung chuyển khoản mặc định
