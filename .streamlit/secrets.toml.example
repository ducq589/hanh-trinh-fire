# Sao chép thành .streamlit/secrets.toml (chạy thử chế độ cloud trên máy)
# hoặc dán vào Streamlit Cloud ▸ App settings ▸ Secrets.  KHÔNG đưa file thật lên GitHub.
[supabase]
url = "https://<project-ref>.supabase.co"            # Supabase ▸ Project Settings ▸ API ▸ Project URL
anon_key = "<anon public key>"                        # Supabase ▸ Project Settings ▸ API Keys ▸ anon / publishable
db_url = "postgresql://postgres.<project-ref>:<MẬT-KHẨU-DB>@aws-0-<region>.pooler.supabase.com:5432/postgres"
                                                      # Supabase ▸ Connect ▸ Session pooler
allow_signup = false                                  # true = ai có email cũng tự đăng ký được
